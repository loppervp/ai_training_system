# ==============================================
# AI PROVIDER API KEYS CONFIGURATION
# ==============================================
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env file to git repository (it's in .gitignore)

# ANTHROPIC / CLAUDE
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OPENROUTER - https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GOOGLE GEMINI - https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

OLLAMA_API_KEY=your_ollama_api_key_here

# SERVER CONFIGURATION
PORT=9001
DEBUG=false

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Database connection for source data extraction
# These values will be used in config/database.json

DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=v57udemo2011
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_SCHEMA=public

# Database pool configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false
